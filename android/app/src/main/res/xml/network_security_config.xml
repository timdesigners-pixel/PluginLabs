<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnız HTTPS. Masaüstü köprüsü (Faz 2) onaylanınca ayrı kural eklenecek. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
