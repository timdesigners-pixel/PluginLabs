{
  "name": "access-lens",
  "version": "0.1.0",
  "private": true,
  "description": "PL-043 Access Lens — Windows uygulaması: seçilen HTML/CSS kesitlerinde kontrast (WCAG 2.2 AA/AAA), form etiketi, görsel alt metni, başlık sırası, odak sırası (tabindex), düğme/bağlantı erişilebilir adı ve semantik bölgeleri denetler; sorun seçildiğinde ilgili öğeyi ve satır numarasını vurgular; kural motoru sürümünü açıkça gösterir ve otomatik puanı erişilebilirlik sertifikası olarak sunmaz (klavye/ekran okuyucu manuel kontrol listesi içerir); MyMind ya da yerel model ile sade açıklama ve düzeltme taslağı önerir; CSV/Markdown/JSON rapor dışa aktarır",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-043-access-lens/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.access-lens",
    "productName": "Access Lens",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "AccessLens-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Access Lens"
    },
    "portable": {
      "artifactName": "AccessLens-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
