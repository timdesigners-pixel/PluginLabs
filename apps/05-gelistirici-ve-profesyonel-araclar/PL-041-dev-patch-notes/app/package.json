{
  "name": "dev-patch-notes",
  "version": "0.1.0",
  "private": true,
  "description": "PL-041 Dev Patch Notes — Windows uygulaması: seçilen git diff veya commit listesini içe alır; değişiklikleri Özellik, Düzeltme, Güvenlik, Kırıcı Değişiklik, Dokümantasyon ve Bakım başlıklarına ayırır; kaynak commit bağlantıları içeren düzenlenebilir sürüm notları hazırlar; API anahtarı ve sır taraması yapar; kanıtsız test geçişi veya performans artışı iddialarını engeller (uydurma teslim iddiası 0); otomatik commit/push/yayın yapmaz; Markdown, Keep a Changelog ve JSON dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı davranış özeti",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-041-dev-patch-notes/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.dev-patch-notes",
    "productName": "Dev Patch Notes",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DevPatchNotes-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Dev Patch Notes"
    },
    "portable": {
      "artifactName": "DevPatchNotes-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
