{
  "name": "design-token-scout",
  "version": "0.1.0",
  "private": true,
  "description": "PL-044 Design Token Scout — Windows uygulaması: seçilen arayüzün computed style JSON, CSS veya HTML örneklerinden renk (hex/rgb/hsl), yazı (font-family, boyut, ağırlık, satır yüksekliği), boşluk ve köşe yarıçapı adaylarını çıkarır; yakın değerleri kümeleyerek token tekrarını azaltır; örnek 5 sayfada ana değerleri ≥%90 kapsar; yalnız kullanıcı onayıyla W3C Design Tokens JSON, CSS :root değişkenleri ve Markdown belge üretir; MyMind ya da yerel model ile semantik token hiyerarşisi önerir",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-044-design-token-scout/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.design-token-scout",
    "productName": "Design Token Scout",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DesignTokenScout-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Design Token Scout"
    },
    "portable": {
      "artifactName": "DesignTokenScout-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
