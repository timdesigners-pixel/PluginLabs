{
  "name": "api-pocket",
  "version": "0.1.0",
  "private": true,
  "description": "PL-042 API Pocket — Windows uygulaması: küçük API çağrılarını istek şablonları ve ortam değişkenleriyle ({{BASE_URL}}, {{API_KEY}}) gönderir, yanıtları biçimlendirir ve yanıt alanlarını açıklar; sırlar işletim sistemi kasasında (DPAPI) saklanır ve günlüklerde/dışa aktarmada görünmesi sıfırdır; ilk sürüm GET ve kullanıcı başlatmalı istek, yazan yöntemlerde (POST/PUT/PATCH/DELETE) ek önizleme ve onay; cURL, Markdown ve JSON koleksiyon dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı yanıt alanı açıklama",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-042-api-pocket/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.api-pocket",
    "productName": "API Pocket",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ApiPocket-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "API Pocket"
    },
    "portable": {
      "artifactName": "ApiPocket-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
