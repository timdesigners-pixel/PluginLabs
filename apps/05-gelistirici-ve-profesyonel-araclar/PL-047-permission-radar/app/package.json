{
  "name": "permission-radar",
  "version": "0.1.0",
  "private": true,
  "description": "PL-047 Permission Radar — Windows uygulaması: tarayıcı eklentilerinin manifest.json ve envanter izinlerini okunabilir Türkçe kartlara dönüştürür, bilinmeyen kapsamları açıkça etiketler, sürümler arası izin değişikliklerini (yeni eklenen/kaldırılan izinleri) gösterir, zararlı yazılım tespiti iddiası taşımaz, Chrome yönetim ekranına yönlendirir ve CSV/Markdown/JSON politika raporu üretir",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-047-permission-radar/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.permission-radar",
    "productName": "Permission Radar",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "PermissionRadar-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Permission Radar"
    },
    "portable": {
      "artifactName": "PermissionRadar-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
