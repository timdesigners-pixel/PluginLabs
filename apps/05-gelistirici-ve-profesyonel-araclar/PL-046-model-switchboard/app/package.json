{
  "name": "model-switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "PL-046 Model Switchboard — Windows uygulaması: model sağlayıcılarını, tarihli katalog fiyatlarıyla istek maliyetlerini ve aynı görevde ürettikleri yanıtları yan yana karşılaştırır; kullanıcı bütçe tavanı (tavan aşımı sıfır hedefi), %100 maliyet görünürlüğü, işletim sistemi kasasında resmi API anahtarı (tüketici web çerezi kullanılmaz), kayıtlı test sonuçlarına bağlı MyMind model önerisi ve CSV/Markdown/JSON dışa aktarma",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-046-model-switchboard/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.model-switchboard",
    "productName": "Model Switchboard",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ModelSwitchboard-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Model Switchboard"
    },
    "portable": {
      "artifactName": "ModelSwitchboard-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
