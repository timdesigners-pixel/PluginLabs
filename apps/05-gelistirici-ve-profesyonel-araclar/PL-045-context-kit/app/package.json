{
  "name": "context-kit",
  "version": "0.1.0",
  "private": true,
  "description": "PL-045 Context Kit — Windows uygulaması: seçilen dosya ve sayfalardan boyut ve token sınırı olan, önizlenebilir AI bağlam paketleri hazırlar; göreve göre dosya/parça sıralar (tüm depoyu otomatik göndermez); hariç tutma kuralları, sır/API anahtarı/kişisel veri maskeleme ve kaynak içi istem enjeksiyonu işaretlemesi uygular (kaynak içi talimatlar veri sayılır); paket boyutunda ≥%40 azalma ve gerekli bağlamda ≥%90 kapsama ölçer; Markdown, XML ve JSON bağlam paketi dışa aktarır; MyMind ya da yerel model ile kısa bağlam özeti üretir",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-045-context-kit/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.context-kit",
    "productName": "Context Kit",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ContextKit-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Context Kit"
    },
    "portable": {
      "artifactName": "ContextKit-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
