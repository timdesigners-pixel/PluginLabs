{
  "name": "offline-aid",
  "version": "0.1.0",
  "private": true,
  "description": "PL-048 Offline Aid — Windows uygulaması: uyumlu yerel modellerle ve modelsiz kural tabanlı yedek motorla metin özetleme, madde çıkarma, yeniden yazma ve eylem maddesi çıkarma işlemlerini cihazda çalıştırır; cihaz kaynak kontrolü (RAM/CPU), görünür model lisansı ve güncelleme kaynağı, donanım bazlı gecikme raporu (ms), dışa giden model isteği sıfır ve TXT/Markdown/JSON dışa aktarma",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-048-offline-aid/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.offline-aid",
    "productName": "Offline Aid",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "OfflineAid-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Offline Aid"
    },
    "portable": {
      "artifactName": "OfflineAid-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
