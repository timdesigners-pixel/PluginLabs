{
  "name": "decision-board",
  "version": "0.1.0",
  "private": true,
  "description": "PL-050 Decision Board — Windows uygulaması: seçenekleri, kriterleri ve ağırlıkları kaynaklı bir karar matrisinde karşılaştırır; her puanın hangi veri, kaynak ve ağırlıktan türediğini (%100 izlenebilirlik) gösterir; artı/eksi listesi, ağırlık duyarlılık analizi, eksik kriter ve çelişki denetimi ile tarihçeli karar günlüğü (ADR Markdown, CSV, JSON) üretir; MyMind ya da yerel model ile kullanıcının tercihlerini dayatmadan eksik kriter ve çelişki önerir. Finansal ve hukuki kararlar için uzman süreci yerine geçmez.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/05-gelistirici-ve-profesyonel-araclar/PL-050-decision-board/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.decision-board",
    "productName": "Decision Board",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DecisionBoard-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Decision Board"
    },
    "portable": {
      "artifactName": "DecisionBoard-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
