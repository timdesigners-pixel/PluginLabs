{
  "name": "insight-table",
  "version": "0.1.0",
  "private": true,
  "description": "PL-040 Insight Table — Windows uygulaması: seçilen HTML tablo, HTML liste, Markdown tablosu, TSV veya CSV metnini sütun önizlemesi ve veri tipi kontrolüyle (sayı/tarih/para/mantıksal/metin, TR/EN ondalık ve tarih normalleştirmesi) yapılandırılmış tabloya dönüştürür; eksik/şüpheli değerleri işaretler, hücre verilerini kaynaksız tamamlamaz; hücre bazında kaynak izi, kişisel veri (PII) maskeleme ve CSV enjeksiyonuna karşı güvenli CSV/JSON dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı sütun normalleştirme",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-040-insight-table/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.insight-table",
    "productName": "Insight Table",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "InsightTable-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Insight Table"
    },
    "portable": {
      "artifactName": "InsightTable-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
