{
  "name": "meeting-trace",
  "version": "0.1.0",
  "private": true,
  "description": "PL-035 Meeting Trace — Windows uygulaması: yüklenen/yapıştırılan toplantı transkriptinden (.txt, Zoom/Teams dökümü, WebVTT, SRT) zaman damgalı konuşma satırları, konuşmacı ayrımı (etiketsiz satırda tahmin işaretli), zaman damgalı notlar ve kanıt satırlı karar/görev taslakları çıkarır; görev sahibi belirsizse Belirsiz, katılımcı değilse Tahmin; her madde insan onayından geçer; tüm toplantılardan onaylı görev listesi; Markdown/CSV/TXT/JSON dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı, takma adlı ve veri azaltılmış ek çıkarım. Ses kaydı yapmaz.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-035-meeting-trace/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.meeting-trace",
    "productName": "Meeting Trace",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "MeetingTrace-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Meeting Trace"
    },
    "portable": {
      "artifactName": "MeetingTrace-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
