{
  "name": "read-partner",
  "version": "0.1.0",
  "private": true,
  "description": "PL-032 Read Partner — Windows uygulaması: yapıştırılan metin ya da yerel belge (.txt/.md/.html) için seçili bölümü yan yana sadeleştirme, terimleri metnin içinden açıklama, 3 anlama sorusu, kaynak içi soru-cevap (yanıt yoksa bilinmiyor), sayfa içi talimatları güvenilmeyen veri olarak işaretleme; MyMind ile isteğe bağlı seviyeli açıklama (onaylı, yalnız seçili paragraflar, alıntı denetimli)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-032-read-partner/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.read-partner",
    "productName": "Read Partner",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ReadPartner-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Read Partner"
    },
    "portable": {
      "artifactName": "ReadPartner-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
