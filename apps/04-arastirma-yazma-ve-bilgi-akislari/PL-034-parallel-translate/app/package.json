{
  "name": "parallel-translate",
  "version": "0.1.0",
  "private": true,
  "description": "PL-034 Parallel Translate — Windows uygulaması: seçilen/yapıştırılan metni paragraf ve cümle bölümlerine ayırıp özgün metinle yan yana çevirir (Türkçe ⇄ İngilizce); kişisel terim sözlüğü (Türkçe ek/ünsüz yumuşaması, İngilizce çoğul/iyelik duyarlı) her bölümde denetlenir; korunan alanlar (sayı, tutar, bağlantı, gizli değer) çeviride aranır; var olan çeviriyi hizalama, sözlük taslağı, kalite notu; TXT/CSV/Markdown/TMX dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı, veri azaltılmış çeviri, alternatif terim ve kısa açıklama",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-034-parallel-translate/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.parallel-translate",
    "productName": "Parallel Translate",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ParallelTranslate-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Parallel Translate"
    },
    "portable": {
      "artifactName": "ParallelTranslate-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
