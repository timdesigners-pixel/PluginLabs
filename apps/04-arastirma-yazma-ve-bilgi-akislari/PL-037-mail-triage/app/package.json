{
  "name": "mail-triage",
  "version": "0.1.0",
  "private": true,
  "description": "PL-037 Mail Triage — Windows uygulaması (salt okunur pilot): seçilen .eml/.mbox dosyalarındaki e-postalar için gerekçeli etiket (Yanıt bekliyor, Fatura/Ödeme, Toplantı, Kargo/Sipariş, Güvenlik, Bülten/Kampanya, Bildirim) ve öncelik önerisi; önemli e-postayı düşük önceliğe atmama korumaları (önemli kişi, doğrudan soru/rica, yakın son tarih, güvenlik); eylem, son tarih ve tutar çıkarımı; toplu değişiklik önizlemesi; öneri kabul/düzeltme ölçüleri; kısa yanıt taslağı (gönderilmez); MyMind (Hub) ya da yerel model ile onaylı, veri azaltılmış öneri",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-037-mail-triage/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.mail-triage",
    "productName": "Mail Triage",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "MailTriage-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Mail Triage"
    },
    "portable": {
      "artifactName": "MailTriage-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
