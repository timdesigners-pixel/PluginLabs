{
  "name": "text-forge",
  "version": "0.1.0",
  "private": true,
  "description": "PL-033 Text Forge — Windows uygulaması: yapıştırılan, panodan (kullanıcı eylemiyle, Ctrl+Shift+Y) ya da .txt/.md dosyasından alınan metni düzeltir, sadeleştirir, kısaltır, biçimlendirir ve seçilen tona (resmî/nötr/samimi/ton örneği) göre yeniden yazar; sayı, tarih, tutar, ad, e-posta, bağlantı gibi sabit alanları korur ve denetler; kelime düzeyinde fark görünümü ve kopyala (kaynak uygulamaya yazma yalnız kullanıcı eylemiyle); MyMind ile onaylı alternatifler (sabit alan değerleri gönderilmez)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-033-text-forge/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.text-forge",
    "productName": "Text Forge",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TextForge-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Text Forge"
    },
    "portable": {
      "artifactName": "TextForge-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
