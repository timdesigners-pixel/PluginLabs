{
  "name": "voice-note-orbit",
  "version": "0.1.0",
  "private": true,
  "description": "PL-036 Voice Note Orbit — Windows uygulaması: yüzen kayıt balonu ya da ana pencereden basılı tutarak kısa ses notu (sürekli dinleme yok, görünür kayıt göstergesi), bu bilgisayardaki OpenAI uyumlu konuşma→metin sunucusuyla onaylı yerel transkripsiyon ya da elle yazma; görev/not ve tarih–saat taslağı (belirsiz tarihte seçenek sunar, uydurmaz); ses dosyası ve transkript ayrı ayrı silinir; ICS/CSV/Markdown dışa aktarma; MyMind (Hub) ya da yerel model ile onaylı, veri azaltılmış düzeltme",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/04-arastirma-yazma-ve-bilgi-akislari/PL-036-voice-note-orbit/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.voice-note-orbit",
    "productName": "Voice Note Orbit",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "bubble.html",
      "bubble.js",
      "bubble.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "VoiceNoteOrbit-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Voice Note Orbit"
    },
    "portable": {
      "artifactName": "VoiceNoteOrbit-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
