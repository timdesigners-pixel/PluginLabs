{
  "name": "daily-brief-widget",
  "version": "0.1.0",
  "private": true,
  "description": "PL-030 Daily Brief Widget — Windows uygulaması: yerel görevler ve kullanıcının eklediği takvimlerden (yerel etkinlik, .ics dosyası, onaylı .ics abonelik adresi; yalnız okuma) günün özeti; her zaman üstte widget, çakışma önerileri, boş aralık ve kısa plan, hassas başlık gizleme, veri zamanı; MyMind ile isteğe bağlı plan (onaylı, veri azaltılmış)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/03-masaustu-dosya-araclari-ve-widgetlar/PL-030-daily-brief-widget/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.daily-brief-widget",
    "productName": "Daily Brief Widget",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "widget.html",
      "widget.js",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DailyBrief-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Daily Brief Widget"
    },
    "portable": {
      "artifactName": "DailyBrief-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
