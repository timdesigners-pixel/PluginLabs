{
  "name": "workspace-scenes",
  "version": "0.1.0",
  "private": true,
  "description": "PL-026 Workspace Scenes — Windows uygulaması: uygulama, klasör, dosya ve bağlantıları kayıtlı çalışma sahneleriyle önizleyip onayla sırayla açar; hiçbir şeyi kapatmaz. Eksik araç önerisi ve MyMind (onaylı)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/03-masaustu-dosya-araclari-ve-widgetlar/PL-026-workspace-scenes/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.workspace-scenes",
    "productName": "Workspace Scenes",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "WorkspaceScenes-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Workspace Scenes"
    },
    "portable": {
      "artifactName": "WorkspaceScenes-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
