{
  "name": "screenshot-studio",
  "version": "0.1.0",
  "private": true,
  "description": "PL-029 Screenshot Studio — Windows uygulaması: bölge/ekran/pencere yakalama; ok, numara, kutu, metin, vurgu, bulanıklaştırma ve kalıcı maske; pencere çerçevesi; panoya kopyalama ve PNG/JPEG kaydetme. Hassas alan adayları cihazda (OCR + kurallar) işaretlenir, insan onaylar; maske çıktıda piksel piksel doğrulanır. MyMind ile isteğe bağlı ek aday (onaylı)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs",
    "postinstall": "node scripts/copy-ocr-data.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/03-masaustu-dosya-araclari-ve-widgetlar/PL-029-screenshot-studio/app"
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.screenshot-studio",
    "productName": "Screenshot Studio",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "overlay.html",
      "overlay.js",
      "overlay.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json",
      "ocr-data/**",
      "!node_modules/tesseract.js/dist/**"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ScreenshotStudio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Screenshot Studio"
    },
    "portable": {
      "artifactName": "ScreenshotStudio-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": false,
    "publish": null
  }
}
