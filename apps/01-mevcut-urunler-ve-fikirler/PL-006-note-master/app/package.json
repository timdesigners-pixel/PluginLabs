{
  "name": "note-master",
  "version": "0.1.0",
  "private": true,
  "description": "PL-006 Note Master — Windows uygulaması: hızlı notları ve görevleri kaynak bağlantısı ve alıntıyla kaydeder (alıntı sınırı, izleme parametresi temizliği), #etiketler, Türkçe duyarlı arama, görev son tarihi ve tamamlama; Markdown ve pluginlabs-note/1 JSON dışa/içe aktarma; hızlı not widget'ı (her zaman üstte, Ctrl+Shift+Space); ilk not süresi ve haftalık geri çağırma ölçütleri; MyMind (Hub) ya da yerel model ile onaylı görev/özet/anahtar kavram taslağı (özgün metin saklanır, gizli notlar varsayılan olarak gönderilmez)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "node tests/desktop-smoke.cjs"
  },
  "main": "desktop/main.js",
  "author": "PluginLabs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/timdesigners-pixel/PluginLabs.git",
    "directory": "apps/01-mevcut-urunler-ve-fikirler/PL-006-note-master/app"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pluginlabs.note-master",
    "productName": "Note Master",
    "copyright": "PluginLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "app.html",
      "app.js",
      "app.css",
      "src/**",
      "pl/**",
      "icons/icon256.png",
      "icons/icon32.png",
      "icons/icon16.png",
      "icons/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "NoteMaster-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Note Master"
    },
    "portable": {
      "artifactName": "NoteMaster-${version}-Windows-Portable-${arch}.${ext}"
    },
    "asar": true,
    "publish": null
  }
}
