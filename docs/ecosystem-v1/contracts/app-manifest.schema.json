{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginLabs application acceptance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "repository",
    "commit",
    "platform",
    "designSystemVersion",
    "permissions",
    "artifact",
    "acceptance",
    "evidence",
    "releaseReady"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "platform": {
      "enum": [
        "win32-x64",
        "linux-x64",
        "darwin-arm64",
        "web",
        "chrome-extension",
        "android"
      ]
    },
    "designSystemVersion": {
      "const": "1.0.0"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "bytes",
        "rollbackVersion"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "rollbackVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast",
        "keyboard",
        "focus",
        "turkish",
        "reducedMotion",
        "dpi",
        "states",
        "install",
        "launch",
        "uninstall",
        "rollback",
        "security"
      ],
      "properties": {
        "contrast": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "keyboard": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "focus": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "turkish": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "reducedMotion": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "dpi": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "states": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "install": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "launch": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "uninstall": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "rollback": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "security": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "screenshots",
        "buildInfo"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "minLength": 1
        },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "buildInfo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releaseReady": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseReady": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "acceptance": {
            "properties": {
              "contrast": {
                "const": "passed"
              },
              "keyboard": {
                "const": "passed"
              },
              "focus": {
                "const": "passed"
              },
              "turkish": {
                "const": "passed"
              },
              "reducedMotion": {
                "const": "passed"
              },
              "dpi": {
                "const": "passed"
              },
              "states": {
                "const": "passed"
              },
              "install": {
                "const": "passed"
              },
              "launch": {
                "const": "passed"
              },
              "uninstall": {
                "const": "passed"
              },
              "rollback": {
                "const": "passed"
              },
              "security": {
                "const": "passed"
              }
            }
          }
        }
      }
    }
  ]
}
